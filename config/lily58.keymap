#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5    |                  |  6   |  7   |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T    |                  |  Y   |  U   |  I    |  O   |   P   | BSPC  |
            // |  CTRL |  A  |  S  |  D   |  F   |  G    |                  |  H   |  J   |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B    |      |  |        |  N   |  M   |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | SPACE |      |  | ENTER | mo 1 | mo 2 |

            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                          &kp N6   &kp N7  &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                           &kp Y    &kp U   &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A   &kp S   &kp D     &kp F     &kp G                           &kp H    &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B    &none      &none       &kp N    &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &kp SPACE  &none    &none       &kp RET  &mo 1   &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        num_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |       |  `  |  ~  |  |   |  =   |  +   |                   |  [   |  ]    |  {    |  }   |   \   |       |
            // |       |     |     |      |      |      |       |  |        |      |  -    |       |      |       |       |
            //                     |      |      |       |       |  |       |      |       |       |

            display-name = "Num";
            bindings = <
&trans  &trans     &trans     &trans    &trans     &trans                       &trans    &trans     &trans     &trans    &trans    &trans
&trans  &kp N1     &kp N2     &kp N3    &kp N4     &kp N5                       &kp N6    &kp N7     &kp N8     &kp N9    &kp N0    &kp GRAVE
&trans  &kp GRAVE  &kp TILDE  &kp PIPE  &kp EQUAL  &kp PLUS                     &kp LBKT  &kp RBKT   &kp LBRC   &kp RBRC  &kp BSLH  &trans
&trans  &trans     &trans     &trans    &trans     &trans   &none    &none      &trans    &kp MINUS  &trans     &trans    &trans    &trans
                              &trans    &trans     &trans   &none    &none      &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |       |     |     |      |      |      |                   |      |       |       |      |   ^   |       |
            // |       |     |     |      |      |      |       |  |        |      |       |       |  <-  |   v   |  ->   |
            //                     |      |      |       |       |  |       |      |       |       |

            display-name = "Nav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans    &trans        &trans
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                          &kp F7  &kp F8  &kp F9  &kp F10   &kp F11       &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans    &kp UP_ARROW  &trans
&trans  &trans  &trans  &trans  &trans  &trans   &none      &none       &trans  &trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT
                        &trans  &trans  &trans     &none    &none       &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // | BTCLR | BT0 | BT1 | BT2  | BT3  | BT4  |                   | BTD0 | BTD1  | BTD2  | BTD3 | BTD4  | EP ON |
            // | EP OFF|     | USB | BLE  | OUT  |      |                   |      |       |       |      |       | EPTOG |
            // |       |     |     |      |      |      |       |  |        |      |       |       |      |       |       |
            //                     |      |      |       |       |  |       |      |       |       |

            display-name = "Adjust";
            bindings = <
&trans             &trans        &trans        &trans        &trans        &trans                        &trans         &trans         &trans         &trans         &trans         &trans
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &ext_power EP_ON
&ext_power EP_OFF  &trans        &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans                        &trans         &trans         &trans         &trans         &trans         &ext_power EP_TOG
&trans             &trans        &trans        &trans        &trans        &trans   &none      &none     &trans         &trans         &trans         &trans         &trans         &trans
                                               &trans        &trans        &trans   &none      &none     &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
